        <mxCell id="ZBfez-qlDdoBK5a3WAGX-3" parent="ZBfez-qlDdoBK5a3WAGX-2" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#D9534F;fillColor=#FFF8F8;dashed=1;verticalAlign=top;align=center;fontSize=11;fontStyle=0;spacingTop=6;container=1;collapsible=0;recursiveResize=0;" value="&lt;b&gt;Security Group: sg-journal-web&lt;/b&gt;&lt;br&gt;&lt;font color='#666666' style='font-size: 10px;'&gt;Inbound: 80 (HTTP), 443 (HTTPS) pour 0.0.0.0/0 | 22 (SSH) restreint IP admin&lt;/font&gt;" vertex="1">
          <mxGeometry height="900" width="580" x="20" y="60" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-4" parent="ZBfez-qlDdoBK5a3WAGX-3" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#ED7100;fillColor=#FFF3E8;verticalAlign=top;align=center;fontSize=12;fontStyle=0;spacingTop=10;container=1;collapsible=0;recursiveResize=0;strokeWidth=2;" value="&lt;b&gt;Instance Amazon EC2 (t3.micro - Amazon Linux 2023)&lt;/b&gt;&lt;br&gt;&lt;font color='#E67E22' style='font-size: 11px;'&gt;Attachée au Rôle IAM : role-journal-app (IMDSv2)&lt;/font&gt;" vertex="1">
          <mxGeometry height="795" width="530" x="20" y="60" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-5" parent="ZBfez-qlDdoBK5a3WAGX-4" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.ec2;" value="" vertex="1">
          <mxGeometry height="35" width="35" x="15" y="10" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-6" parent="ZBfez-qlDdoBK5a3WAGX-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#2ECC71;align=left;spacingLeft=15;fontSize=11;" value="&lt;b&gt;Serveur Frontal Nginx (Ports 80 &amp; 443)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #555555;'&gt;- Terminaison SSL/TLS (HTTPS &amp; WSS)&lt;br&gt;- Routage dynamique /ws vers port 1234 &amp; /api vers port 8000&lt;br&gt;- Compression gzip &amp; Keep-Alive&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="400" x="30" y="65" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-7" parent="ZBfez-qlDdoBK5a3WAGX-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECF7;strokeColor=#8E44AD;align=left;spacingLeft=15;fontSize=11;strokeWidth=1.5;" value="&lt;b&gt;Service Collab Temps Réel (Node.js - Port 1234)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #555555;'&gt;- Moteur CRDT Yjs (y-websocket)&lt;br&gt;- Synchronisation binaire des deltas textuels (C2)&lt;br&gt;- Gestion de l'Awareness (curseurs &amp; présences)&lt;br&gt;- Décompte et contrôle du crédit 10k caractères/jour (C4)&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="400" x="50" y="240" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-8" parent="ZBfez-qlDdoBK5a3WAGX-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2980B9;align=left;spacingLeft=15;fontSize=11;strokeWidth=1.5;" value="&lt;b&gt;Passerelle API &amp; Gatekeeper (Node.js - Port 8000)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #555555;'&gt;- Endpoints REST : Auth déclarative, Liens, Snapshots&lt;br&gt;- &lt;b&gt;Gatekeeper Téléchargement (C1) :&lt;/b&gt; Arbitre le quota N=500 au pic&lt;br&gt;- Décrément atomique DynamoDB &amp; Délivrance par jeton à usage unique&lt;br&gt;- État dynamique : Vérification &amp;rarr; Patientez &amp;rarr; Prêt &amp;rarr; Épuisé&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="400" x="50" y="360" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-9" parent="ZBfez-qlDdoBK5a3WAGX-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#F39C12;align=left;spacingLeft=15;fontSize=11;" value="&lt;b&gt;Worker de Compilation PDF (Service d'arrière-plan SQS)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #555555;'&gt;- Consommateur asynchrone de la file SQS (Long Polling)&lt;br&gt;- Moteur de rendu haute vélocité (Typst natif Rust &amp;lt; 80 ms, RAM &amp;lt; 40 Mo)&lt;br&gt;- Dépôt du PDF final sur Amazon S3 par clé de version (C3)&lt;br&gt;- Suppression sécurisée du message SQS acquitté&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="400" x="50" y="490" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-10" parent="ZBfez-qlDdoBK5a3WAGX-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F4F4;strokeColor=#7F8C8D;align=left;spacingLeft=15;fontSize=10;dashed=1;" value="&lt;b&gt;Supervision systemd &amp; Stockage Local EBS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #555555;'&gt;- Services journal-collab.service, journal-api.service, journal-worker.service&lt;br&gt;- Redémarrage automatique en cas d'anomalie (Restart=always)&lt;br&gt;- /etc/journal.env (Noms de ressources AWS, zéro clé)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="400" x="50" y="660" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-11" parent="ZBfez-qlDdoBK5a3WAGX-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E91E63;align=left;spacingLeft=65;fontSize=11;strokeWidth=2;" value="&lt;b&gt;Amazon SQS (Simple Queue Service)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #333333;'&gt;&lt;b&gt;File standard : pdf-generation-queue&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Découplage asynchrone &amp; Lissage de charge (C5) :&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Ordre de compilation unique par version (absorbe le pic)&lt;br&gt;• Délai de visibilité : 60 s (temps de compilation Typst &amp;lt; 80 ms)&lt;br&gt;• Premier million de requêtes gratuit chaque mois&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="440" x="1100" y="320" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-12" parent="ZBfez-qlDdoBK5a3WAGX-11" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.sqs;" value="" vertex="1">
          <mxGeometry height="45" width="45" x="15" y="35" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-13" parent="ZBfez-qlDdoBK5a3WAGX-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;align=left;spacingLeft=65;fontSize=11;strokeWidth=2;" value="&lt;b&gt;Amazon S3 (Stockage Objet Privé)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #333333;'&gt;&lt;b&gt;Bucket : s3://revue-documents-storage&lt;/b&gt;&lt;br&gt;• Stockage sécurisé et pérenne des PDFs compilés (par clé de version)&lt;br&gt;• Sauvegarde des instantanés (Snapshots T1) de documents&lt;br&gt;• &lt;b&gt;Délivrance contrôlée à usage unique :&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;Flux servi exclusivement aux 500 admis via jeton vérifié&lt;br&gt;&amp;nbsp;&amp;nbsp;Garantie mathématique d'aucun dépassement de quota (zéro fuite de lien)&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="440" x="1080" y="700" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-14" parent="ZBfez-qlDdoBK5a3WAGX-13" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.s3;" value="" vertex="1">
          <mxGeometry height="45" width="45" x="15" y="50" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-15" parent="ZBfez-qlDdoBK5a3WAGX-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;align=left;spacingLeft=65;fontSize=11;strokeWidth=1.5;" value="&lt;b&gt;Amazon SNS (Simple Notification Service)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #333333;'&gt;&lt;b&gt;Sujet : alerte-dernier-exemplaire&lt;/b&gt;&lt;br&gt;• Déclenché dès &lt;code&gt;places_restantes == 0&lt;/code&gt; (C6)&lt;br&gt;• Notification par e-mail automatique au créateur du lien&lt;br&gt;• Découplé, sans serveur SMTP local&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="440" x="1090" y="910" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-16" parent="ZBfez-qlDdoBK5a3WAGX-15" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.sns;" value="" vertex="1">
          <mxGeometry height="45" width="45" x="15" y="30" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-17" parent="ZBfez-qlDdoBK5a3WAGX-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#AB47BC;align=left;spacingLeft=55;fontSize=10;" value="&lt;b&gt;AWS IAM (IMDSv2)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #333333;'&gt;Rôle d'instance &lt;code&gt;role-journal-app&lt;/code&gt; au moindre privilège : S3 Put/Get, DynamoDB Update/Get, SQS Send/Receive, SNS Publish. Aucune clé codée en dur.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="440" x="1100" y="1140" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-18" parent="ZBfez-qlDdoBK5a3WAGX-17" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#759C3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.iam;" value="" vertex="1">
          <mxGeometry height="35" width="35" x="10" y="18" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-19" parent="ZBfez-qlDdoBK5a3WAGX-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#FF5722;align=left;spacingLeft=55;fontSize=10;" value="&lt;b&gt;Amazon CloudWatch&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #333333;'&gt;Métriques CPU/RAM EC2, profondeur de file SQS, requêtes DynamoDB, logs Nginx/App et preuve de coût.&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="440" x="1100" y="1330" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-20" parent="ZBfez-qlDdoBK5a3WAGX-19" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.cloudwatch;" value="" vertex="1">
          <mxGeometry height="35" width="35" x="10" y="15" as="geometry"/>
