        <mxCell id="ZBfez-qlDdoBK5a3WAGX-21" edge="1" parent="ZBfez-qlDdoBK5a3WAGX-1" source="ZBfez-qlDdoBK5a3WAGX-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8E44AD;strokeWidth=2;fontSize=10;fontColor=#8E44AD;entryX=0.002;entryY=0.335;entryDx=0;entryDy=0;entryPerimeter=0;" target="ZBfez-qlDdoBK5a3WAGX-23" value="&lt;b&gt;1. Écriture Append-Only (C2)&lt;/b&gt;&lt;br&gt;&amp; Décompte crédit 10k (C4)">
          <mxGeometry relative="1" x="-0.4006" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-22" edge="1" parent="ZBfez-qlDdoBK5a3WAGX-1" source="ZBfez-qlDdoBK5a3WAGX-8" style="rounded=1;strokeColor=#2E27AD;strokeWidth=2.5;fontSize=10;fontColor=#2E27AD;fontStyle=1;entryX=0.014;entryY=0.945;entryDx=0;entryDy=0;exitX=0.981;exitY=0.032;exitDx=0;exitDy=0;exitPerimeter=0;edgeStyle=orthogonalEdgeStyle;entryPerimeter=0;" target="ZBfez-qlDdoBK5a3WAGX-23" value="&lt;b&gt;2. Décrément conditionnel atomique&lt;/b&gt;&lt;br&gt;&lt;code&gt;remaining &amp;gt; 0&lt;/code&gt; (Contrainte C1)">
          <mxGeometry relative="1" x="0.2976" as="geometry">
            <mxPoint as="offset"/>
            <Array as="points">
              <mxPoint x="630" y="553.2"/>
              <mxPoint x="630" y="270"/>
              <mxPoint x="1000" y="270"/>
