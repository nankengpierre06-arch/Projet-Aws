        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-23" parent="ZBfez-qlDdoBK5a3WAGX-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3F51B5;align=left;spacingLeft=65;fontSize=11;strokeWidth=2;" value="&lt;b&gt;Amazon DynamoDB (Mode On-Demand)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #333333;'&gt;&lt;b&gt;Table unique : JournalTable (Single-Table Design)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Compteur atomique LINK#id (C1) :&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;SET rem = rem - 1 WHERE rem &amp;gt; 0&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Journal durable Append-Only (C2 &amp; C3) :&lt;/b&gt; DOC#id / REV#seq&lt;br&gt;• &lt;b&gt;Statut de compilation PDF :&lt;/b&gt; PENDING | READY (ordre SQS unique)&lt;br&gt;• &lt;b&gt;Crédits quotidiens (C4) :&lt;/b&gt; USER#email / CREDIT#date&lt;br&gt;• Arbitrage en &amp;lt; 10 ms sans verrouillage applicatif&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="440" x="1100" y="100" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-24" parent="ZBfez-qlDdoBK5a3WAGX-23" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#2E27AD;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.dynamodb;" value="" vertex="1">
          <mxGeometry height="45" width="45" x="15" y="45" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-25" parent="1" style="shape=mxgraph.aws4.group;grType=user;fillColor=#F3E5F5;strokeColor=#8E44AD;strokeWidth=2;fontSize=12;align=center;verticalAlign=top;spacingTop=10;whiteSpace=wrap;html=1;" value="&lt;b&gt;300 Rédacteurs Actifs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #666666;'&gt;Navigateurs Web (React/Quill/Yjs)&lt;br&gt;• Connexions longues WSS&lt;br&gt;• Petits deltas textuels fréquents&lt;br&gt;• Partage de curseurs &amp; présence&lt;br&gt;• Quota 10k caractères/jour (C4)&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="250" x="-290" y="-515" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-26" parent="1" style="shape=mxgraph.aws4.group;grType=user;fillColor=#EBF5FB;strokeColor=#2980B9;strokeWidth=2;fontSize=12;align=center;verticalAlign=top;spacingTop=10;whiteSpace=wrap;html=1;" value="&lt;b&gt;15 000 Visiteurs (Pic de Parution)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #666666;'&gt;Navigateurs Web Anonymes&lt;br&gt;• Rafale : 80% en 1 min (~200 req/s)&lt;br&gt;• Compétition pour 500 places (C1)&lt;br&gt;• &lt;b&gt;500 admis :&lt;/b&gt; Téléchargement contrôlé par jeton unique&lt;br&gt;• &lt;b&gt;14 500 refusés :&lt;/b&gt; Réponse 410 'Épuisé' immédiate en &amp;lt; 15 ms&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="250" x="-310" y="-275" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-27" parent="1" style="shape=mxgraph.aws4.group;grType=user;fillColor=#FFF3E0;strokeColor=#E67E22;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=top;spacingTop=10;whiteSpace=wrap;html=1;" value="&lt;b&gt;Créateur du Document / Lien&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 10px; color: #666666;'&gt;Boîte e-mail du rédacteur créateur&lt;br&gt;Reçoit l'alerte 'Dernier exemplaire'&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="250" x="40" y="750" as="geometry"/>
        </mxCell>
