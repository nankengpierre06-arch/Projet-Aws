          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ZBfez-qlDdoBK5a3WAGX-31" edge="1" parent="1" source="ZBfez-qlDdoBK5a3WAGX-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2980B9;strokeWidth=2;fontSize=9;fontColor=#2980B9;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" target="ZBfez-qlDdoBK5a3WAGX-8" value="Proxy HTTP&lt;br&gt;127.0.0.1:8000">
