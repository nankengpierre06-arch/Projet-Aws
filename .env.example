# Configuration de l'environnement AWS et Serveur
PORT_API=8000
PORT_COLLAB=1234
USE_AWS_MOCK=false

# Configuration de la région AWS (ex: eu-west-3 pour Paris, us-east-1 pour N. Virginia)
AWS_REGION=eu-west-3

# Noms des ressources créées sur la console AWS
DYNAMODB_TABLE=JournalTable
S3_BUCKET=revue-documents-storage
SQS_QUEUE_URL=https://sqs.eu-west-3.amazonaws.com/VOTRE_ACCOUNT_ID/pdf-generation-queue
SNS_TOPIC_ARN=arn:aws:sns:eu-west-3:VOTRE_ACCOUNT_ID:alerte-dernier-exemplaire

# Identifiants IAM (si exécuté en local en se connectant aux services AWS réels)
# Si vous utilisez AWS Academy / Learner Lab, collez les identifiants ici :
# AWS_ACCESS_KEY_ID=ASI...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...
