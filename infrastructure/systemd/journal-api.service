[Unit]
Description=Passerelle API REST & Gatekeeper (Port 8000)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/var/www/journal/backend
EnvironmentFile=/etc/journal.env
ExecStart=/usr/bin/node src/api/server.js
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

